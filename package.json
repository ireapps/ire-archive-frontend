{
  "name": "site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepare": "svelte-kit sync",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:preview": "TEST_MODE=preview playwright test",
    "test:e2e:preview:ui": "TEST_MODE=preview playwright test --ui",
    "test:e2e:deployed": "playwright test tests/e2e/preview-smoke.spec.ts --project=chromium",
    "test:lighthouse": "lhci autorun",
    "verify": "npm run format:check && npm run lint && npm run check && npm run test:coverage && npm run build"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "sass": "^1.105.1",
    "svelte": "^5.43.5",
    "svelte-check": "^4.7.6",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@vercel/analytics": "^1.6.1",
    "lucide-svelte": "^0.561.0"
  }
}
